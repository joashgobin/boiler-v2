limit_req_zone $binary_remote_addr zone=<appName>_<ipHash>:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=<appName>_<ipHash>_static:10m rate=50r/s;

server {
    server_name <ip> www.<ip>;

    gzip on;
    gzip_min_length 1100;
    gzip_buffers 4 32k;
    gzip_types
        text/plain
        text/css
        text/javascript
        text/xml
        text/markdown
        text/csv
        application/json
        application/javascript
        application/ecmascript
        application/xml
        application/rss+xml
        application/atom+xml
        application/rdf+xml
        application/wasm
        application/vnd.ms-fontobject
        font/ttf
        font/otf
        font/woff
        font/woff2;
    gzip_vary on;

    brotli on;
    brotli_static on;
    brotli_comp_level 11; # Recommended compression level
    brotli_types
        text/plain
        text/css
        text/javascript
        text/xml
        text/markdown
        text/csv
        application/json
        application/javascript
        application/ecmascript
        application/xml
        application/rss+xml
        application/atom+xml
        application/rdf+xml
        application/wasm
        application/vnd.ms-fontobject
        font/ttf
        font/otf
        font/woff
        font/woff2;

    location / {
        limit_req zone=<appName>_<ipHash> burst=20 nodelay;
        limit_req_status 429;

        proxy_pass http://localhost:<port>;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /static/ {
        limit_req zone=<appName>_<ipHash>_static burst=50 nodelay;
        limit_req_status 429;

        alias /home/<user>/<appName>/static/;
        expires 1y;
        access_log off;
        add_header Cache-Control "public, must-revalidate";
    }

    location ~ \.map$ {
        return 404;
    }

}
